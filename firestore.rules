rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles: each user can only access their own document.
    match /users/{userId} {
      allow get, list: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'guest';

      // Role and uid are immutable from the client (prevents self-promotion).
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // Library content: publicly readable, only admins can modify.
    match /sheetMusic/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /videos/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /collections/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /people/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Everything else is locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
